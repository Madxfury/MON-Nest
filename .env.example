# Public browser configuration. The booking address is set only after deployment.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_PROPERTY_REGISTRY_ADDRESS=
NEXT_PUBLIC_RENTAL_ESCROW_ADDRESS=
NEXT_PUBLIC_DISPUTE_COURT_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_MON_NEST_BOOKINGS_ADDRESS=
# Decimal block number of the MonNestBookings deployment receipt; required for event history.
NEXT_PUBLIC_MON_NEST_BOOKINGS_DEPLOY_BLOCK=
NEXT_PUBLIC_BROKER_ADDRESS=

# Mera is the final provider. No hosted project ID or API key is needed.
# Passkey credentials are bound to the current domain, not shared with localhost.

# Server-only sponsor service configuration. Never prefix secrets with NEXT_PUBLIC_.
ENVIO_API_TOKEN=
ENVIO_HYPERRPC_TOKEN=
ALCHEMY_MONAD_TESTNET_RPC_URL=
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_SECRET=
# Earliest deployment block across ALL contracts indexed (not necessarily Bookings).
INDEXER_START_BLOCK=

# Hardhat deployment only. Keep the private key out of Vercel and Git.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
DEPLOYER_PRIVATE_KEY=
BROKER_ADDRESS=
